# Guard: ~/.claude holds ~1 GB of caches, session state and secrets. Only the
# small config files belong in this repo, and it is PUBLIC. If anything below
# ever gets symlinked or copied in here, git must refuse it.

# Credentials and auth
.credentials.json
daemon-auth-*.json
daemon-auth-cooldown
*.key
*.pem
*.token

# Session state — transcripts, prompt history, per-project memory.
# These contain source paths, code excerpts and private repo details.
projects/
history.jsonl
transcripts/
file-history/
todos/
sessions/
session-data/
session-env/
.session-stats.json

# Caches and installed artifacts (hundreds of MB)
plugins/
context-mode/
cache/
backups/
downloads/
shell-snapshots/
statsig/

# Runtime / telemetry
daemon/
daemon.log
telemetry/
tasks/
jobs/
debug/
.last-cleanup

# Skills: the whole dir is symlinked from ~/.claude/skills, so a new skill is
# tracked with no extra wiring. `learned/` is Claude Code's own output — vendor
# managed, same reasoning as the untracked SessionStart hooks.
/skills/learned/

# Editor/OS noise
*.bak
*.swp
.DS_Store
