{
  "skillListingBudgetFraction": 0.02,
  "env": {
    "ENABLE_LSP_TOOL": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(git pull *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "mcp__plugin_playwright_playwright__*",
      "mcp__plugin_supabase_supabase__*"
    ],
    "deny": [
      "Bash(git config user.email:*)",
      "Bash(git config user.name:*)",
      "Bash(git config --local user.email:*)",
      "Bash(git config --local user.name:*)",
      "Bash(git config --global user.email:*)",
      "Bash(git config --global user.name:*)",
      "Bash(sudo *)",
      "Bash(curl http*)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Read(**/.env)",
      "Read(**/secrets/**)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__lean-ctx__ctx_shell|mcp__lean-ctx__shell",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/momeppkt/.config/claude-code/hooks/deny-git-identity-override.sh",
            "timeout": 10,
            "statusMessage": "Checking git identity..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-hud@claude-hud": true,
    "product-management@synced": false,
    "design@synced": false,
    "cowork-plugin-management@synced": false,
    "superpowers@synced": false,
    "i-have-adhd@synced": false,
    "pstack@pstack-claude": true
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "momepp/claude-hud"
      }
    },
    "pstack-claude": {
      "source": {
        "source": "github",
        "repo": "michael-denyer/pstack-claude"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "advisorModel": "fable",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "editorMode": "vim",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoCompactEnabled": true,
  "syncClaudeAiSkills": false
}
