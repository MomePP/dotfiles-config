{
  "skillListingBudgetFraction": 0.02,
  "env": {
    "ENABLE_LSP_TOOL": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(git pull *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "mcp__plugin_playwright_playwright__*",
      "mcp__plugin_context-mode_context-mode__*",
      "mcp__plugin_supabase_supabase__*",
      "mcp__codegraph__*"
    ],
    "deny": [
      "Bash(git config user.email:*)",
      "Bash(git config user.name:*)",
      "Bash(git config --local user.email:*)",
      "Bash(git config --local user.name:*)",
      "Bash(git config --global user.email:*)",
      "Bash(git config --global user.name:*)",
      "Bash(sudo *)",
      "Bash(curl http*)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Read(**/.env)",
      "Read(**/secrets/**)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/momeppkt/.config/claude-code/hooks/deny-git-identity-override.sh",
            "timeout": 10,
            "statusMessage": "Checking git identity..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-hud@claude-hud": true,
    "context-mode@context-mode": true,
    "product-management@synced": false,
    "design@synced": false,
    "cowork-plugin-management@synced": false
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "momepp/claude-hud"
      }
    },
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    }
  },
  "effortLevel": "high",
  "advisorModel": "fable",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "editorMode": "vim",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoCompactEnabled": true,
  "syncClaudeAiSkills": false
}
