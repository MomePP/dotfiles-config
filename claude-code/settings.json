{
  "skillListingBudgetFraction": 0.02,
  "env": {
    "ENABLE_LSP_TOOL": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(git pull *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "mcp__plugin_playwright_playwright__*",
      "mcp__plugin_supabase_supabase__*",
      "mcp__lean-ctx__ctx_read",
      "mcp__lean-ctx__ctx_shell",
      "mcp__lean-ctx__shell",
      "mcp__lean-ctx__ctx_search",
      "mcp__lean-ctx__ctx_glob",
      "mcp__lean-ctx__ctx_tree",
      "mcp__lean-ctx__ctx_compose",
      "mcp__lean-ctx__ctx_call",
      "mcp__lean-ctx__ctx_patch",
      "mcp__lean-ctx__ctx_optimize",
      "mcp__lean-ctx__ctx_overview",
      "mcp__lean-ctx__ctx_preload",
      "mcp__lean-ctx__ctx_compress",
      "mcp__lean-ctx__ctx_compare",
      "mcp__lean-ctx__ctx_metrics",
      "mcp__lean-ctx__ctx_session",
      "mcp__lean-ctx__ctx_knowledge",
      "mcp__lean-ctx__ctx_analyze",
      "mcp__lean-ctx__ctx_benchmark",
      "mcp__lean-ctx__ctx_cache",
      "mcp__lean-ctx__ctx_discover",
      "mcp__lean-ctx__ctx_delta",
      "mcp__lean-ctx__ctx_edit",
      "mcp__lean-ctx__ctx_dedup",
      "mcp__lean-ctx__ctx_fill",
      "mcp__lean-ctx__ctx_intent",
      "mcp__lean-ctx__ctx_response",
      "mcp__lean-ctx__ctx_context",
      "mcp__lean-ctx__ctx_graph",
      "mcp__lean-ctx__ctx_outline",
      "mcp__lean-ctx__ctx_callgraph",
      "mcp__lean-ctx__ctx_refactor",
      "mcp__lean-ctx__ctx_routes",
      "mcp__lean-ctx__ctx_cost",
      "mcp__lean-ctx__ctx_heatmap",
      "mcp__lean-ctx__ctx_gain",
      "mcp__lean-ctx__ctx_expand",
      "mcp__lean-ctx__ctx_impact",
      "mcp__lean-ctx__ctx_architecture",
      "mcp__lean-ctx__ctx_review",
      "mcp__lean-ctx__ctx_pack",
      "mcp__lean-ctx__ctx_index",
      "mcp__lean-ctx__ctx_artifacts",
      "mcp__lean-ctx__ctx_smells",
      "mcp__lean-ctx__ctx_quality",
      "mcp__lean-ctx__ctx_proof",
      "mcp__lean-ctx__ctx_verify",
      "mcp__lean-ctx__ctx_execute",
      "mcp__lean-ctx__ctx_feedback",
      "mcp__lean-ctx__ctx_control",
      "mcp__lean-ctx__ctx_plan",
      "mcp__lean-ctx__ctx_compile",
      "mcp__lean-ctx__ctx_discover_tools",
      "mcp__lean-ctx__ctx_provider",
      "mcp__lean-ctx__ctx_radar",
      "mcp__lean-ctx__ctx_retrieve",
      "mcp__lean-ctx__ctx_compress_memory",
      "mcp__lean-ctx__ctx_load_tools",
      "mcp__lean-ctx__ctx"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(git config user.email:*)",
      "Bash(git config user.name:*)",
      "Bash(git config --local user.email:*)",
      "Bash(git config --local user.name:*)",
      "Bash(git config --global user.email:*)",
      "Bash(git config --global user.name:*)",
      "Bash(sudo *)",
      "Bash(curl http*)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Read(**/.env)",
      "Read(**/secrets/**)",
      "Grep",
      "Glob"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__lean-ctx__ctx_shell|mcp__lean-ctx__shell",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/momeppkt/.config/claude-code/hooks/deny-git-identity-override.sh",
            "timeout": 10,
            "statusMessage": "Checking git identity..."
          }
        ]
      }
    ]
  },
  "model": "opus",
  "enabledPlugins": {
    "claude-hud@claude-hud": true,
    "product-management@synced": false,
    "design@synced": false,
    "cowork-plugin-management@synced": false,
    "superpowers@synced": false,
    "i-have-adhd@synced": false,
    "pstack@pstack-claude": true
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "momepp/claude-hud"
      }
    },
    "pstack-claude": {
      "source": {
        "source": "github",
        "repo": "michael-denyer/pstack-claude"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "advisorModel": "fable",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "editorMode": "vim",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoCompactEnabled": true,
  "syncClaudeAiSkills": false
}
