{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "disabled": false
      }
    }
  },
  "plugins": [
    "context-mode@latest",
    "@tarquinen/opencode-dcp@latest",
    "@slkiser/opencode-quota@latest",
    "oh-my-opencode-slim"
  ],
  "agents": {
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    }
  },
  "experimental": {
    "quotaToast": {
      "enableToast": false,
      "showSessionTokens": true,
      "enabledProviders": "auto",
      "percentDisplayMode": "used",
      "formatStyle": "allWindows",
      "opencodeGoWindows": [
        "rolling",
        "weekly",
        "monthly"
      ]
    }
  },
  "lsp": true
}
