{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "oxocarbon"
  },
  "keybinds": {
    "session.half.page.up": "ctrl+u",
    "session.half.page.down": "ctrl+d"
  },
  "plugins": [
    "@slkiser/opencode-quota@latest",
    "opencode-vim@latest"
  ],
  "scroll": {
    "acceleration": true
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true
}
