configstore
tmux/plugins

github-copilot
gh
.nuxtrc
.nuxt/devtools
.copilot
mole
/opencode/context-mode/
/opencode/opencode-quota
/.tmp/external-context
/glab-cli
/.claude/settings.local.json
/.claude/tmp/

# opencode serve's local auth password, in cleartext — this repo is public
/opencode/service.json

# oh-my-opencode-slim's update bookkeeping: a manifest of skill hashes plus a
# staged copy of each upstream skill version, used to diff against the
# customized copies in opencode/skills/. Regenerated by the plugin.
/opencode/.oh-my-opencode-slim/

# installed and auto-updated by Paseo (each carries .paseo-managed-files.json)
claude-code/skills/paseo*/

# wrangler state landing here because a run resolved XDG_CONFIG_HOME to ~/.config;
# config/default.toml holds a Cloudflare OAuth token and the logs can echo it
/.wrangler/

# plugin dev deps: type-only, restorable with `npm install`, ~90 MB unpacked
/paseo/plugins/*/node_modules/
/paseo/plugins/*/package-lock.json

# opencode package deps and plugin-managed files — regenerated by opencode,
# oh-my-opencode-slim (its bundled skills) and Paseo (terminal-activity plugin)
/opencode/node_modules/
/opencode/package.json
/opencode/package-lock.json
/opencode/bun.lock
/opencode/plugins/paseo-terminal-activity.js
/opencode/skills/clonedeps/
/opencode/skills/codemap/
/opencode/skills/deepwork/
/opencode/skills/oh-my-opencode-slim/
/opencode/skills/reflect/
/opencode/skills/simplify/
/opencode/skills/verification-planning/
/opencode/skills/worktrees/

# personal work-hour log, not config
/opencode/effort-log.md

# brew's flock file for trust.json
/homebrew/trust.json.lock
