# herdr: track config.toml and the plugin config TOMLs (herdr-plus project +
# worktree templates); ignore runtime state (logs, sockets, session) and the
# plugin clones/binaries herdr manages itself.
/herdr/*
!/herdr/config.toml
!/herdr/plugins/
/herdr/plugins/*
!/herdr/plugins/config/
/herdr/plugins/config/*
!/herdr/plugins/config/cloudmanic.herdr-plus/
/herdr/plugins/config/cloudmanic.herdr-plus/*
!/herdr/plugins/config/cloudmanic.herdr-plus/projects/
!/herdr/plugins/config/cloudmanic.herdr-plus/worktrees/

# Superset drops its Amp lifecycle plugin here; vendor-owned, updated by the app.
/amp/plugins/superset-lifecycle.ts

# assistant scratch
.claude/tmp/

# installed and auto-updated by Paseo (each carries .paseo-managed-files.json)
claude-code/skills/paseo*/
