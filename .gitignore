# installed and auto-updated by Paseo (each carries .paseo-managed-files.json)
claude-code/skills/paseo*/

# installed and updated by the `skills` CLI (npx skills add), which keeps the
# real copy in ~/.agents/skills and tracks it in ~/.agents/.skill-lock.json
claude-code/skills/design-taste-frontend

# wrangler state landing here because a run resolved XDG_CONFIG_HOME to ~/.config;
# config/default.toml holds a Cloudflare OAuth token and the logs can echo it
/.wrangler/

# brew's flock file for trust.json
/homebrew/trust.json.lock

# Paseo reinstalls its opencode activity hook here on every start while
# enableTerminalAgentHooks is on (no per-agent toggle), opencode or not
/opencode/

# carapace's zsh bridge (CARAPACE_BRIDGES in zsh/.zprofile) writes a throwaway
# ZDOTDIR here: an empty .zshrc and a compdump it regenerates on demand
/carapace/bridge/
