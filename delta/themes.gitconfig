[delta "oxocarbon"]
    dark                          = true
    line-numbers                  = true
    side-by-side                  = false
    keep-plus-minus-markers       = false

    syntax-theme                  = oxocarbon-dark

    file-style                    = "#dde1e6" bold
    file-decoration-style         = "#393939" ul
    file-added-label              = [+]
    file-copied-label             = [==]
    file-modified-label           = [*]
    file-removed-label            = [-]
    file-renamed-label            = [->]

    # Hunk headers
    hunk-header-style             = omit

    # Diff styles
    minus-style                   = "#ee5396" "#2a161d"
    minus-emph-style              = "#161616" "#ee5396" bold
    minus-non-emph-style          = minus-style
    minus-empty-line-marker-style = minus-style

    plus-style                    = "#3ddbd9" "#0e2324"
    plus-emph-style               = "#161616" "#3ddbd9" bold
    plus-non-emph-style           = plus-style
    plus-empty-line-marker-style  = plus-style

    # Line numbers
    line-numbers-minus-style      = "#ee5396"
    line-numbers-plus-style       = "#3ddbd9"
    line-numbers-zero-style       = "#525252"
    line-numbers-left-style       = "#525252"
    line-numbers-right-style      = "#525252"
    line-numbers-left-format      = "{nm:>4} ."
    line-numbers-right-format     = "{np:>4}  "

