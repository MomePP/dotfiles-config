{
  "setup": [
    "mkdir -p .claude/tmp",
    "cp -n \"$SUPERSET_ROOT_PATH/.claude/settings.local.json\" .claude/settings.local.json 2>/dev/null || true",
    "command -v codegraph >/dev/null && codegraph init . || echo 'codegraph not installed, skipping index'"
  ],
  "teardown": [
    "[ -f .codegraph/daemon.pid ] && kill \"$(cat .codegraph/daemon.pid)\" 2>/dev/null || true"
  ]
}
