# font config
font-family = Maple Mono NF
font-family = Sukhumvit Set
font-size = 14
# font-thicken = true
adjust-cell-height = 8%
# alpha-blending = linear-corrected

# cursor config
mouse-hide-while-typing = true
# auto-copy mouse selection to the system clipboard (native-style copy, incl. in
# the herd.nvim float where win.mouse=false hands the mouse to ghostty)
copy-on-select = clipboard
# `title` sets the pane title from the shell (OSC 2) — tmux falls back to the
# hostname without it, so `choose-tree` shows no path. nushell used to emit this
# itself via shell_integration.osc2; zsh ships nothing of the sort.
shell-integration-features = cursor,title
cursor-style = block

# macos icon
macos-icon = blueprint

# colorscheme
theme = oxocarbon
background-opacity = 0.80
background-blur-radius = 20
bold-is-bright = true

# window config
macos-titlebar-style = hidden
window-padding-balance = true
window-padding-x = 8
window-padding-y = 4

# quick terminal config
quick-terminal-space-behavior = remain
quick-terminal-screen = macos-menu-bar

# input config
macos-option-as-alt = true

# loads keybinding
config-file = ?keybinding
