# font config
font-family = Maple Mono NF
font-family = Sukhumvit Set
font-size = 14
# font-thicken = true
adjust-cell-height = 8%
# alpha-blending = linear-corrected

# cursor config
mouse-hide-while-typing = true
copy-on-select = clipboard
# `title` sets the pane title from the shell (OSC 2) — tmux falls back to the
# hostname without it, so `choose-tree` shows no path; zsh ships nothing of the
# sort. `no-cursor`: .zshrc sets the shape per vi keymap itself (an omitted
# feature keeps its default, and cursor defaults on).
shell-integration-features = no-cursor,title
cursor-style = block

# macos icon
macos-icon = blueprint

# colorscheme
theme = oxocarbon
background-opacity = 0.80
background-blur-radius = 20
bold-is-bright = true

# window config
macos-titlebar-style = hidden
window-padding-balance = true
window-padding-x = 8
window-padding-y = 4

# quick terminal config
quick-terminal-size = 99.5%,99.5%
quick-terminal-animation-duration = 0
quick-terminal-space-behavior = remain

# The quick terminal reuses its last frame (saved across restarts) instead of
# quick-terminal-size; `never` stops that state from surviving a quit.
window-save-state = never

# input config
macos-option-as-alt = true

# loads keybinding
config-file = ?keybinding
